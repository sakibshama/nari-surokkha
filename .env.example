# ============================================================
# Nari Surokkha — root .env for the LOCAL DEVELOPMENT docker-compose.yml
#
# Optional: every value below has a dev default in docker-compose.yml.
# Copy to `.env` (git-ignored) only to override them.
#
# Production uses .env.production.example; staging uses
# deploy/staging/.env.example. The API's own variables for `npm run dev`
# live in services/api/.env (copy services/api/.env.example).
# ============================================================

# PostGIS
DB_USER=nari_user
DB_PASSWORD=nari_dev_password
DB_NAME=nari_surokkha_dev
DB_PORT=5432

# Redis (started with --requirepass). When running the API natively, use:
#   REDIS_URL=redis://:nari_dev_redis@localhost:6379
REDIS_PASSWORD=nari_dev_redis
REDIS_PORT=6379

# MinIO (S3-compatible evidence storage)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin

# Dev-only JWT secrets for the containerised API (profile "app"), >= 64 chars.
# JWT_SECRET=
# JWT_REFRESH_SECRET=

# ------------------------------------------------------------
# API variables you need in services/api/.env when running `npm run dev`
# against this stack (reference — not read by docker compose):
#
#   DATABASE_URL=postgresql://nari_user:nari_dev_password@localhost:5432/nari_surokkha_dev?schema=public
#   DIRECT_DATABASE_URL=postgresql://nari_user:nari_dev_password@localhost:5432/nari_surokkha_dev?schema=public
#       (schema.prisma's directUrl; without PgBouncer it equals DATABASE_URL)
#   REDIS_URL=redis://:nari_dev_redis@localhost:6379
#   NODE_ENV=development            # development | test | staging | production
#   PHONE_VERIFICATION=optional     # required | optional (default: required in production/staging)
#   TRUST_PROXY=false               # default 1 in production/staging, false otherwise
#   TURN_HOST= / TURN_SECRET=       # coturn use-auth-secret; empty = STUN only
#   EVIDENCE_URL_SECRET=            # optional, >= 32 chars; HMAC for local evidence URLs
# ------------------------------------------------------------
