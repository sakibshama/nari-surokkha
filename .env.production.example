# ============================================================
# Nari Surokkha — PRODUCTION environment (single VPS)
#
# Copy to `.env.production` on the server and fill every value.
# NEVER commit the real .env.production. Keep a secure backup.
#
# Generate strong secrets:
#   JWT secrets:            openssl rand -hex 48
#   CONFIG_ENCRYPTION_KEY:  openssl rand -hex 32
#   passwords / API keys:   openssl rand -base64 24
#
# Replace `example.com` everywhere with your real domain.
# ============================================================

# ─── Domain (used by nginx + CORS) ─────────────────────────
DOMAIN=example.com

# ─── Container images (set automatically by CI on deploy) ──
# For a manual/local build leave these; CI overrides REGISTRY + TAG.
REGISTRY=ghcr.io/YOUR_GITHUB_USER/nari-surokkha
TAG=latest

# ─── Server ────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
API_BASE_URL=https://api.example.com

# ─── Database (PostgreSQL + PostGIS) ───────────────────────
POSTGRES_DB=nari_surokkha
POSTGRES_USER=nari_user
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
# Must match the three values above; host is the compose service name.
DATABASE_URL=postgresql://nari_user:CHANGE_ME_strong_db_password@postgres:5432/nari_surokkha

# ─── Redis ─────────────────────────────────────────────────
REDIS_PASSWORD=CHANGE_ME_strong_redis_password
REDIS_URL=redis://:CHANGE_ME_strong_redis_password@redis:6379

# ─── Auth / JWT (>= 64 chars each) ─────────────────────────
JWT_SECRET=CHANGE_ME_openssl_rand_hex_48
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_hex_48_different
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ─── Secret encryption (admin-managed SMS keys AND payment gateway keys) ─
CONFIG_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32
# SSLCommerz / Stripe are added in the Admin Portal → Payment Gateways.
# API_BASE_URL must be the public HTTPS address: the gateways redirect and
# post back to {API_BASE_URL}/api/v1/subscriptions/...

# ─── CORS — MUST be explicit (wildcard is rejected in prod) ─
CORS_ORIGINS=https://admin.example.com
WS_CORS_ORIGINS=https://admin.example.com

# ─── Evidence storage (server disk, bind-mounted for backup) ─
# Host path that gets mounted into the API container at /app/uploads.
UPLOADS_DIR=/opt/nari-surokkha/data/uploads
STORAGE_LOCAL_DIR=/app/uploads

# ─── TURN relay (WebRTC streaming across networks) ─────────
# Must match the credential hardcoded in the mobile app / portals.
TURN_PASSWORD=CHANGE_ME_turn_password

# ─── ML Service (internal) ─────────────────────────────────
ML_SERVICE_URL=http://ml-service:8000
ML_SERVICE_API_KEY=CHANGE_ME_shared_ml_secret

# ─── Firebase (push notifications — optional but recommended) ─
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── SMS fallback (live config is managed in the Admin Portal) ─
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=NariSurokkha
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Portal build-time API URLs (baked into the static bundles) ─
ADMIN_VITE_API_URL=https://api.example.com/api/v1
PUBLIC_WS_URL=https://api.example.com

# ─── Monitoring (optional) ─────────────────────────────────
SENTRY_DSN=

# ─── Logging ───────────────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=false

# ============================================================
# Added 2026-08-19 — observability, scale-out and pooling
# ============================================================

# ─── Database through PgBouncer ─────────────────────────────
# Runtime queries go through the pooler; migrations must NOT (DDL and Prisma's
# advisory locks cannot survive transaction-mode pooling).
DATABASE_URL=postgresql://nari_user:CHANGE_ME@pgbouncer:5432/nari_surokkha?pgbouncer=true&connection_limit=10
DIRECT_DATABASE_URL=postgresql://nari_user:CHANGE_ME@postgres:5432/nari_surokkha
DATABASE_POOL_MAX=10

# PgBouncer sizing. DEFAULT_POOL_SIZE is per database/user pair — keep
# (replicas x connection_limit) comfortably under Postgres max_connections.
PGB_MAX_CLIENT_CONN=500
PGB_DEFAULT_POOL_SIZE=25

# ─── Postgres tuning (sized for ~8GB RAM; scale with the host) ──
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=6GB
PG_WORK_MEM=16MB
PG_MAX_CONNECTIONS=200
PG_MEM_LIMIT=4g

# ─── Redis ──────────────────────────────────────────────────
# noeviction is deliberate: Redis holds BullMQ jobs and live tracking tokens.
REDIS_MAXMEMORY=512mb
REDIS_MEM_LIMIT=768m

# ─── Process roles / scale-out ──────────────────────────────
# The API and worker run the same image; WORKER_MODE picks which half is live.
# Scale with: docker compose -f docker-compose.prod.yml up -d --scale api=3
API_REPLICAS=1
WORKER_REPLICAS=1
API_MEM_LIMIT=1g
WORKER_MEM_LIMIT=1g

# ─── Metrics ────────────────────────────────────────────────
# Served on METRICS_PORT, internal network only — nginx returns 404 for
# /metrics and /queues on the public API host.
METRICS_ENABLED=true
METRICS_PORT=9091

# Bull Board queue inspector, on the metrics port behind basic auth.
# Leave BULLBOARD_PASSWORD empty to disable it entirely.
BULLBOARD_ENABLED=false
BULLBOARD_USER=admin
BULLBOARD_PASSWORD=

# ─── Error tracking ─────────────────────────────────────────
# Leave SENTRY_DSN ABSENT (not empty) to disable. Only the user id is sent —
# never phone numbers, locations or evidence keys.
# SENTRY_DSN=https://...@o0.ingest.sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Monitoring stack (profile: monitoring) ─────────────────
# docker compose -f docker-compose.prod.yml --profile monitoring up -d
# Grafana binds to 127.0.0.1 only — reach it via: ssh -L 3000:localhost:3000
GRAFANA_PASSWORD=CHANGE_ME
PROM_RETENTION=30d
PROM_MEM_LIMIT=1g
# Slack/Discord/Teams incoming webhook for alerts.
ALERT_WEBHOOK_URL=

# ============================================================
# Added 2026-08-19 (round 2) — evidence storage, retention, replica
# ============================================================

# ─── Evidence in object storage ─────────────────────────────
# THIS is what allows more than one API host. With STORAGE_PROVIDER=local the
# API is pinned to whichever machine holds the uploads volume.
STORAGE_PROVIDER=cloudflare-r2          # local | minio | aws-s3 | cloudflare-r2
S3_BUCKET_EVIDENCE=nari-evidence
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
# Encryption at rest. Unset = SSE-S3 (AES256). Set a KMS key id for a
# customer-managed key with its own audit trail.
# S3_KMS_KEY_ID=

# How long evidence is kept after its alert is CLOSED. Evidence attached to an
# open legacy case is never purged, whatever its age.
EVIDENCE_RETENTION_DAYS=365

# ─── Read replica (optional) ────────────────────────────────
# When set, analytics and audit-log reads route here instead of the primary.
# REPLICA_DATABASE_URL=postgresql://nari_user:CHANGE_ME@postgres-replica:5432/nari_surokkha
