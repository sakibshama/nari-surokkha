# ============================================================
# Nari Surokkha — PRODUCTION environment (single VPS)
#
# Copy to `.env.production` on the server and fill every value.
# NEVER commit the real .env.production. Keep a secure backup.
#
# Generate strong secrets:
#   JWT secrets:            openssl rand -hex 48
#   CONFIG_ENCRYPTION_KEY:  openssl rand -hex 32
#   passwords / API keys:   openssl rand -base64 24
#
# Replace `example.com` everywhere with your real domain.
# ============================================================

# ─── Domain (used by nginx + CORS) ─────────────────────────
DOMAIN=example.com

# ─── Container images (set automatically by CI on deploy) ──
# For a manual/local build leave these; CI overrides REGISTRY + TAG.
REGISTRY=ghcr.io/YOUR_GITHUB_USER/nari-surokkha
TAG=latest

# ─── Server ────────────────────────────────────────────────
NODE_ENV=production
PORT=3001
HOST=0.0.0.0
API_BASE_URL=https://api.example.com

# ─── Database (PostgreSQL + PostGIS) ───────────────────────
POSTGRES_DB=nari_surokkha
POSTGRES_USER=nari_user
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password
# DATABASE_URL / DIRECT_DATABASE_URL are set once, in the PgBouncer section
# below — they must use the same user/password/db as the three values above.

# ─── Redis ─────────────────────────────────────────────────
# docker-compose.prod.yml starts redis with --requirepass ${REDIS_PASSWORD};
# the password inside REDIS_URL MUST be the same value.
REDIS_PASSWORD=CHANGE_ME_strong_redis_password
REDIS_URL=redis://:CHANGE_ME_strong_redis_password@redis:6379

# ─── Auth / JWT (>= 64 chars each) ─────────────────────────
JWT_SECRET=CHANGE_ME_openssl_rand_hex_48
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_hex_48_different
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ─── Secret encryption (admin-managed SMS keys AND payment gateway keys) ─
# REQUIRED. Encrypts SMS-provider and payment-gateway secrets stored in the
# database. Back it up with the database backups' key material: if it is
# lost, every saved gateway/SMS secret must be re-entered in the portal, and
# changing it makes the stored secrets unreadable.
CONFIG_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32
# SSLCommerz / Stripe are added in the Admin Portal → Payment Gateways.
# API_BASE_URL must be the public HTTPS address: the gateways redirect and
# post back to {API_BASE_URL}/api/v1/subscriptions/...

# ─── CORS — MUST be explicit (wildcard is rejected in prod) ─
CORS_ORIGINS=https://admin.example.com
WS_CORS_ORIGINS=https://admin.example.com

# ─── Evidence storage (server disk, bind-mounted for backup) ─
# Host path that gets mounted into the API container at /app/uploads.
# Used only with STORAGE_PROVIDER=local. The container runs as uid 1000, so:
#   sudo chown -R 1000:1000 /opt/nari-surokkha/data/uploads
UPLOADS_DIR=/opt/nari-surokkha/data/uploads
STORAGE_LOCAL_DIR=/app/uploads

# ─── TURN relay (WebRTC streaming across networks) ─────────
# coturn runs with --use-auth-secret --static-auth-secret=${TURN_SECRET}. The
# API hands each client a 1-hour HMAC credential derived from the same secret
# (GET /config/ice-servers); nothing static is shipped in the apps.
# TURN_HOST is the public hostname clients relay through (the VPS).
# Open 3478/tcp+udp and 49152-49200/udp (deploy/production/scripts/vps-setup.sh).
TURN_HOST=api.example.com
TURN_SECRET=CHANGE_ME_openssl_rand_hex_32

# ─── Reverse proxy / client IP (B3) ─────────────────────────
# Number of trusted proxy hops in front of the API. nginx is the only one, and
# it overwrites X-Forwarded-For with the connecting address. Use a comma list
# of addresses/CIDRs instead if you add a CDN or load balancer.
TRUST_PROXY=1

# ─── Phone verification (OTP on registration, B4) ──────────
# required | optional. Unset = required in production. Needs a real
# SMS provider (configured in the Admin Portal or SMS_* below).
PHONE_VERIFICATION=required

# ─── Signed evidence URLs (B6) ──────────────────────────────
# HMAC key (>= 32 chars) for /evidence/mock-s3/... links when
# STORAGE_PROVIDER=local. Optional: falls back to a key derived from
# JWT_SECRET (rotating JWT_SECRET then also invalidates evidence links).
EVIDENCE_URL_SECRET=CHANGE_ME_openssl_rand_hex_32

# ─── Firebase (push notifications — optional but recommended) ─
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ─── SMS fallback (live config is managed in the Admin Portal) ─
SMS_PROVIDER=mock
SMS_API_KEY=
SMS_API_SECRET=
SMS_SENDER_ID=NariSurokkha
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# ─── Portal build-time API URLs (baked into the static bundles) ─
ADMIN_VITE_API_URL=https://api.example.com/api/v1
PUBLIC_WS_URL=https://api.example.com

# ─── Monitoring (optional) ─────────────────────────────────
SENTRY_DSN=

# ─── Logging ───────────────────────────────────────────────
LOG_LEVEL=info
LOG_PRETTY=false

# ============================================================
# Added 2026-08-19 — observability, scale-out and pooling
# ============================================================

# ─── Database through PgBouncer ─────────────────────────────
# Runtime queries go through the pooler; migrations must NOT (DDL and Prisma's
# advisory locks cannot survive transaction-mode pooling). schema.prisma reads
# DIRECT_DATABASE_URL for `prisma migrate deploy` — both are REQUIRED here.
# Use the POSTGRES_USER / POSTGRES_PASSWORD / POSTGRES_DB values from above.
DATABASE_URL=postgresql://nari_user:CHANGE_ME_strong_db_password@pgbouncer:5432/nari_surokkha?pgbouncer=true&connection_limit=10
DIRECT_DATABASE_URL=postgresql://nari_user:CHANGE_ME_strong_db_password@postgres:5432/nari_surokkha
DATABASE_POOL_MAX=10

# PgBouncer sizing. DEFAULT_POOL_SIZE is per database/user pair — keep
# (replicas x connection_limit) comfortably under Postgres max_connections.
PGB_MAX_CLIENT_CONN=500
PGB_DEFAULT_POOL_SIZE=25

# ─── Postgres tuning (sized for ~8GB RAM; scale with the host) ──
PG_SHARED_BUFFERS=2GB
PG_EFFECTIVE_CACHE_SIZE=6GB
PG_WORK_MEM=16MB
PG_MAX_CONNECTIONS=200
PG_MEM_LIMIT=4g

# ─── Redis ──────────────────────────────────────────────────
# noeviction is deliberate: Redis holds BullMQ jobs and live tracking tokens.
REDIS_MAXMEMORY=512mb
REDIS_MEM_LIMIT=768m

# ─── Process roles / scale-out ──────────────────────────────
# The API and worker run the same image; WORKER_MODE picks which half is live.
# Scale with: docker compose -f docker-compose.prod.yml up -d --scale api=3
API_REPLICAS=1
WORKER_REPLICAS=1
API_MEM_LIMIT=1g
WORKER_MEM_LIMIT=1g

# ─── Metrics ────────────────────────────────────────────────
# Served on METRICS_PORT, internal network only — nginx returns 404 for
# /metrics and /queues on the public API host.
METRICS_ENABLED=true
METRICS_PORT=9091

# Bull Board queue inspector, on the metrics port behind basic auth.
# Leave BULLBOARD_PASSWORD empty to disable it entirely.
BULLBOARD_ENABLED=false
BULLBOARD_USER=admin
BULLBOARD_PASSWORD=

# ─── Error tracking ─────────────────────────────────────────
# Leave SENTRY_DSN ABSENT (not empty) to disable. Only the user id is sent —
# never phone numbers, locations or evidence keys.
# SENTRY_DSN=https://...@o0.ingest.sentry.io/0
SENTRY_TRACES_SAMPLE_RATE=0.1

# ─── Monitoring stack (profile: monitoring) ─────────────────
# docker compose -f docker-compose.prod.yml --profile monitoring up -d
# Grafana binds to 127.0.0.1 only — reach it via: ssh -L 3000:localhost:3000
GRAFANA_PASSWORD=CHANGE_ME
PROM_RETENTION=30d
PROM_MEM_LIMIT=1g
# Slack-compatible incoming webhook for alerts (REQUIRED for the monitoring
# profile; Alertmanager refuses to start without it). Slack:
# https://hooks.slack.com/services/... ; Discord: append /slack to the webhook URL.
ALERT_WEBHOOK_URL=

# ============================================================
# Added 2026-08-19 (round 2) — evidence storage, retention, replica
# ============================================================

# ─── Evidence in object storage ─────────────────────────────
# THIS is what allows more than one API host. With STORAGE_PROVIDER=local the
# API is pinned to whichever machine holds the uploads volume.
STORAGE_PROVIDER=cloudflare-r2          # local | minio | aws-s3 | cloudflare-r2
S3_BUCKET_EVIDENCE=nari-evidence
S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
S3_REGION=auto
S3_ACCESS_KEY=CHANGE_ME
S3_SECRET_KEY=CHANGE_ME
# Encryption at rest. Unset = SSE-S3 (AES256). Set a KMS key id for a
# customer-managed key with its own audit trail.
# S3_KMS_KEY_ID=

# How long evidence is kept after its alert is CLOSED. Evidence attached to an
# open legacy case is never purged, whatever its age.
EVIDENCE_RETENTION_DAYS=365

# ─── Read replica (optional) ────────────────────────────────
# When set, analytics and audit-log reads route here instead of the primary.
# REPLICA_DATABASE_URL=postgresql://nari_user:CHANGE_ME@postgres-replica:5432/nari_surokkha

# ============================================================
# Backups (deploy/production/scripts/backup.sh) — see
# docs/operations/backup-and-restore.md
# ============================================================
# Encryption: an age PUBLIC key (recommended) OR a GPG recipient whose public
# key is imported on the server. The PRIVATE key must NOT live on this server.
BACKUP_AGE_RECIPIENT=age1CHANGE_ME_public_key
# BACKUP_GPG_RECIPIENT=backups@example.com

# Off-site, S3-compatible bucket (Cloudflare R2, Backblaze B2, AWS S3, Wasabi…)
BACKUP_S3_URI=s3://nari-backups/production
BACKUP_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
BACKUP_S3_REGION=auto
BACKUP_AWS_ACCESS_KEY_ID=CHANGE_ME
BACKUP_AWS_SECRET_ACCESS_KEY=CHANGE_ME
# Retention: daily copies for N days, plus the first backup of each month for
# M months. Local copies (unencrypted dumps are never kept) for L days.
BACKUP_RETENTION_DAYS=14
BACKUP_MONTHLY_RETENTION_MONTHS=12
BACKUP_LOCAL_RETENTION_DAYS=3
# Optional dead-man's switch (e.g. healthchecks.io): pinged on success, /fail on failure.
BACKUP_HEALTHCHECK_URL=

# ─── WAL-G point-in-time recovery (optional override) ───────
# Used only with: -f deploy/production/walg/docker-compose.walg.yml
# WALG_S3_PREFIX=s3://nari-backups/wal
# WALG_S3_ENDPOINT=https://<accountid>.r2.cloudflarestorage.com
# WALG_S3_REGION=auto
# WALG_AWS_ACCESS_KEY_ID=
# WALG_AWS_SECRET_ACCESS_KEY=
# WALG_PGP_PUBLIC_KEY_FILE=/opt/nari-surokkha/secrets/walg-public.asc
