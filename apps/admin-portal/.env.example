# ============================================================
# Nari Surokkha — Admin Portal Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
# ============================================================

# ─── API ────────────────────────────────────────────────────
# Used by src/services/api.ts and socket.ts, and by the production
# Content-Security-Policy built in vite.config.ts (connect-src / img-src).
VITE_API_URL=http://localhost:3001/api/v1
VITE_WS_URL=http://localhost:3001
# Optional extra CSP origins (space-separated), e.g. your S3/R2 evidence bucket
# VITE_CSP_EXTRA=https://evidence.example.com

# ─── Maps ──────────────────────────────────────────────────
VITE_MAPBOX_ACCESS_TOKEN=pk.your_mapbox_token_here
# OR for Google Maps:
# VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# ─── App ────────────────────────────────────────────────────
VITE_APP_NAME=Nari Surokkha Admin Portal
VITE_APP_ENV=development
