# ============================================================
# Nari Surokkha — Mobile App Environment Variables
# Copy this file to .env and fill in real values
# NEVER commit .env to version control
#
# Only variables prefixed EXPO_PUBLIC_ reach the app bundle.
# ============================================================

# ─── API ────────────────────────────────────────────────────
# Normally you do NOT need to set this in development: the app derives the
# dev server address from Metro's own host, so a phone on the same Wi-Fi
# reaches your machine automatically (http://<your-ip>:3001/api/v1).
#
# Set it when the API runs somewhere else — another machine, a tunnel, or a
# staging server:
# EXPO_PUBLIC_API_URL=http://192.168.0.225:3001/api/v1
# EXPO_PUBLIC_WS_URL=http://192.168.0.225:3001
#
# Note the path: the API serves everything under /api/v1 (app.ts registers
# that prefix), so the base URL ends in /api/v1 — not /api.

# Only if your API listens on a port other than 3001:
# EXPO_PUBLIC_API_PORT=3001

# ─── Maps ──────────────────────────────────────────────────
# The Google Maps key is configured server-side (Admin → Settings), not here.

# ─── Firebase ──────────────────────────────────────────────
# Add google-services.json in the project root / android/app — never keys here.

# ─── App ────────────────────────────────────────────────────
APP_ENV=development
