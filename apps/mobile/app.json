{
  "expo": {
    "name": "Nari Surokkha",
    "slug": "nari-surokkha",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.narisurokkha.app",
      "infoPlist": {
        "UIBackgroundModes": [
          "location",
          "fetch",
          "remote-notification",
          "audio"
        ],
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Allow Nari Surokkha to use your location in the background to ensure you remain on safe routes and active SOS broadcasts are continuous."
      }
    },
    "android": {
      "package": "com.narisurokkha.app",
      "googleServicesFile": "./google-services.json",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.USE_EXACT_ALARM",
        "android.permission.CAMERA",
        "android.permission.SEND_SMS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.FOREGROUND_SERVICE_LOCATION"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-notifications",
      "@config-plugins/react-native-webrtc",
      "./withCustomProguard.js",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow Nari Surokkha to use the microphone to detect a shout, crying, \"Help\" or \"Bachao\" and start an emergency alert. Audio stays on your phone."
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Nari Surokkha to use your location in the background to ensure you remain on safe routes and active SOS broadcasts are continuous."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "./plugins/withEmergencyListening.js",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Nari Surokkha to attach photos and videos you choose to an incident report or SOS. Location data is removed before upload.",
          "cameraPermission": "Allow Nari Surokkha to take photos and videos for an incident report or as SOS evidence.",
          "microphonePermission": "Allow Nari Surokkha to record sound with videos you take for an incident report."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "0c8649fc-01e7-4202-ad19-4ce86fd77a3b"
      },
      "apiUrl": "https://api.mystrix-soft.com/api/v1",
      "wsUrl": "https://api.mystrix-soft.com"
    },
    "scheme": "narisurokkha"
  }
}
