# ============================================================
# Nari Surokkha — Edge reverse proxy (TLS + subdomains)
# ${DOMAIN} is substituted at container start (envsubst).
#
# Subdomains (point all three A-records at the VPS IP):
#   api.${DOMAIN}     -> API (Fastify) + WebSocket / WebRTC signaling
#   admin.${DOMAIN}   -> Admin portal (static)
# ============================================================

# ---- Shared upgrade map for WebSockets ----
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

# ---- API upstream pool ----
# Was a single hardcoded `proxy_pass http://api:3001`, which meant scaling the
# API required editing nginx. Docker's embedded DNS resolves `api` to every
# replica, and least_conn spreads load by active connections -- the right
# metric here, because a long-lived Socket.IO connection is not comparable to
# a short REST call.
#
# Sticky sessions are NOT required: Socket.IO uses the Redis adapter, and the
# clients connect with transports: ['websocket'], skipping the HTTP long-poll
# handshake that would otherwise need session affinity.
upstream nari_api {
    least_conn;
    server api:3001 max_fails=3 fail_timeout=10s;
    keepalive 32;
}

# ---- Rate limiting at the edge ----
# Defence in depth in front of the app's own Redis-backed limiter: this sheds
# obvious floods before they cost a Node worker or a Redis round trip.
# The SOS endpoint is deliberately NOT limited here -- the application layer
# handles it per user, and dropping a real emergency at the edge is unacceptable.
limit_req_zone $binary_remote_addr zone=api_general:10m rate=30r/s;
limit_req_zone $binary_remote_addr zone=api_auth:10m rate=1r/s;

# ---- Compression ----
gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_min_length 512;
gzip_types application/json application/javascript text/css text/plain
           image/svg+xml application/manifest+json;

# ---- HTTP: ACME challenge + redirect everything else to HTTPS ----
server {
    listen 80;
    listen [::]:80;
    server_name api.${DOMAIN} admin.${DOMAIN};

    # Let's Encrypt webroot challenge
    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

# ---- API (api.${DOMAIN}) ----
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name api.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    # Evidence uploads (multipart) — API caps files at 10MB; allow headroom.
    client_max_body_size 25m;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Metrics and the queue inspector live on the API's internal port 9091 and
    # are intentionally unreachable from here. Reach them over the Docker
    # network or an SSH tunnel.
    location /metrics { return 404; }
    location /queues  { return 404; }

    # Stricter limit on credential endpoints (brute-force surface).
    location /api/v1/auth/ {
        limit_req zone=api_auth burst=10 nodelay;
        proxy_pass http://nari_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location / {
        limit_req zone=api_general burst=60 nodelay;

        proxy_pass http://nari_api;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Connection "";

        # WebSocket / Socket.IO / WebRTC signaling upgrade
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;

        # Retry the next upstream if one replica is unhealthy, so a single bad
        # container does not surface as a failed SOS.
        proxy_next_upstream error timeout http_502 http_503 http_504;
        proxy_next_upstream_tries 2;

        proxy_read_timeout 3600s;
        proxy_send_timeout 3600s;
    }
}

# ---- Admin portal (admin.${DOMAIN}) ----
server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name admin.${DOMAIN};

    ssl_certificate     /etc/letsencrypt/live/${DOMAIN}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${DOMAIN}/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers HIGH:!aNULL:!MD5;

    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options SAMEORIGIN always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    # Vite emits content-hashed filenames, so these can be cached forever.
    location /assets/ {
        proxy_pass http://admin-portal:80;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
    }

    location / {
        proxy_pass http://admin-portal:80;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
