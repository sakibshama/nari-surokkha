# ============================================================
# Nari Surokkha — STAGING environment
# Copy to deploy/staging/.env and fill every value. Never commit the real file.
#   secrets:  openssl rand -hex 48     keys: openssl rand -hex 32
# ============================================================

# Public origin of the staging host (no trailing slash). Used for CORS, the
# portal build and links in SMS (tracking / contact consent).
STAGING_URL=http://staging.example.com
STAGING_HTTP_PORT=80

# Database (PostGIS)
DB_USER=nari_user
DB_PASSWORD=CHANGE_ME_staging_db_password
DB_NAME=nari_surokkha_staging

# Redis
REDIS_PASSWORD=CHANGE_ME_staging_redis_password

# Auth (>= 64 characters each, different values)
JWT_SECRET=CHANGE_ME_openssl_rand_hex_48
JWT_REFRESH_SECRET=CHANGE_ME_openssl_rand_hex_48_different

# Encrypts admin-managed SMS / payment gateway secrets at rest (openssl rand -hex 32)
CONFIG_ENCRYPTION_KEY=CHANGE_ME_openssl_rand_hex_32

# HMAC key for signed local evidence URLs (>= 32 chars). Optional: falls back
# to a key derived from JWT_SECRET.
EVIDENCE_URL_SECRET=

# SMS provider fallback (live config is set in the Admin Portal)
SMS_PROVIDER=mock
# Phone OTP on registration: required | optional (empty = required on staging).
# With SMS_PROVIDER=mock no SMS is delivered, so testers need `optional`.
PHONE_VERIFICATION=optional

# TURN (coturn use-auth-secret). Leave empty to serve STUN only.
TURN_HOST=
TURN_SECRET=

OSRM_URL=https://router.project-osrm.org
