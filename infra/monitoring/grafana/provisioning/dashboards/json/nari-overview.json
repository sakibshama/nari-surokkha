{
  "title": "Nari Surokkha \u2014 Overview",
  "uid": "nari-overview",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "tags": [
    "nari-surokkha"
  ],
  "templating": {
    "list": [
      {
        "name": "DS_PROMETHEUS",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        },
        "hide": 2
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "SOS trigger latency p95 (s)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(sos_trigger_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "SOS dispatch latency p95 (s)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.95, sum(rate(sos_dispatch_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Alerts created / min",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(alerts_total[5m])) * 60",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Notification failure ratio by channel",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(notifications_total{status=\"failed\"}[10m])) by (channel) / clamp_min(sum(rate(notifications_total[10m])) by (channel), 0.001)",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "HTTP requests / s by status",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_request_duration_seconds_count[5m])) by (status_code)",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "HTTP 5xx ratio",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_request_duration_seconds_count{status_code=~\"5..\"}[5m])) / clamp_min(sum(rate(http_request_duration_seconds_count[5m])), 0.001)",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Queue depth (waiting / failed)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(queue_depth{state=~\"waiting|failed\"}) by (queue, state)",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 8,
      "type": "timeseries",
      "title": "WebSocket connections",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 24
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(websocket_connections) by (instance)",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 9,
      "type": "timeseries",
      "title": "Event loop lag p99 (s)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "nodejs_eventloop_lag_p99_seconds",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 10,
      "type": "timeseries",
      "title": "Process memory (RSS)",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 32
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_resident_memory_bytes",
          "legendFormat": "__auto"
        }
      ]
    },
    {
      "id": 11,
      "type": "timeseries",
      "title": "Scrape targets up",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS_PROMETHEUS}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=~\"api|worker\"}",
          "legendFormat": "__auto"
        }
      ]
    }
  ]
}